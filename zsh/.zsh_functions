export STOW_FOLDERS="autorandr,bin,action-hub,kitty,i3,zsh,fonts,rofi,fonts,fzf,vim,nvim,git,dunst,pi,picom,ssh"

increaseWatchers() {
    sudo sysctl fs.inotify.max_user_watches=65536
    sudo sysctl -p
}

die() {
    echo >&2 "$@"
    exit 1
}

addToPath() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$PATH:$1
    fi
}

addToPathFront() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$1:$PATH
    fi
}

unalias s 2>/dev/null
# SSH wrapper with fzf host picker.
# Usage:
#   s              — pick a host interactively via fzf
#   s <host>       — connect directly
s() {
    if [[ $# -eq 0 ]]; then
        # Collect Host entries from both the shared and machine-local configs,
        # skip wildcard blocks (Host *), then fuzzy-pick one.
        local host
        host=$(grep -h "^Host " ~/.ssh/config ~/.ssh/config.local 2>/dev/null \
            | awk '{print $2}' \
            | grep -v '^\*$' \
            | fzf --prompt="SSH > ")
        [[ -n "$host" ]] && kitty +kitten ssh "$host"
    else
        kitty +kitten ssh "$@"
    fi
}

