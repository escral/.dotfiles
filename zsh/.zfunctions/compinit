setopt localoptions extendedglob

local _wrap_dir="${DOTFILES}/zsh/.zfunctions"
local _our_dump="${HOME}/.zcompdump-fast"
local -a _stale _saved_fpath

_stale=($_our_dump(N.mh+2))
_saved_fpath=($fpath)

# Remove our dir temporarily so autoload finds the real compinit (prevents recursion)
fpath=("${(@)fpath:#$_wrap_dir}")
unfunction compinit
autoload -Uz compinit

if [[ -f $_our_dump ]] && (( ${#_stale} == 0 )); then
  compinit -C -d "$_our_dump"
else
  compinit -u -d "$_our_dump"
fi

fpath=($_saved_fpath)
