#!/usr/bin/env zsh

# ── Environment ───────────────────────────────────────────────────────────────
export XDG_CONFIG_HOME=$HOME/.config
export DOTFILES=$HOME/.dotfiles

# ── PATH ──────────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.local/scripts:$PATH"
export PATH="$HOME/.local/.npm-global/bin:$PATH"
export PATH="$HOME/.local/share/fnm:$PATH"

# ── oh-my-zsh ─────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Prefer history-based suggestions, fall back to completion engine
export ZSH_AUTOSUGGEST_STRATEGY=(history completion)

plugins=(
    yarn
    npm
    zsh-autosuggestions
)

# --- Oh My Zsh ----------------------------------------------------------------
source $ZSH/oh-my-zsh.sh

# ── Tool integrations ─────────────────────────────────────────────────────────
[ -f ~/.fzf.zsh ]          && source ~/.fzf.zsh
[ -f "$HOME/.deno/env" ]   && source "$HOME/.deno/env"

# ── Key bindings ──────────────────────────────────────────────────────────────
bindkey '\t'   autosuggest-accept   # Tab        → accept suggestion
bindkey '\e'   autosuggest-clear    # Esc        → clear suggestion
bindkey '^ '   autosuggest-fetch    # Ctrl+Space → fetch suggestion
bindkey '^[[Z' complete-word        # Shift+Tab  → complete word

# ── Local overrides ───────────────────────────────────────────────────────────
# Machine-specific config not tracked in the repo
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# ── General env variables ─────────────────────────────────────────────────────
export NODE_OPTIONS="--max-old-space-size=4096"
