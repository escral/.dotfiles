# General
alias ff='fzm'
alias ffp='fzm | open-project-nvim'
alias www="cd /var/www"
alias vim="nvim"
alias s="kitty +kitten ssh"

# JS
alias pn='pnpm'

# PHP
alias cda="composer dump-autoload"
alias pa="php artisan"

# Git
alias gc='git add . && git commit -m'
alias save='git add -A && git diff --cached --quiet || (printf "Commit message: " && read msg && git commit -m "$msg" && git push)'

# Utils
alias img="kitty +kitten icat"
alias copy="kitty +kitten clipboard"

# Docker
alias dcrm='docker ps -aq | xargs -r docker rm -f'

# Other
# shellcheck disable=SC2142
alias my_ip="ip address | grep -o \"inet 192.*/\" | awk '{ print \$2 }' | tr / ' ' | xargs"

alias dotFileInstall="$DOTFILES/install"

# Coding Agent
alias pi='VISUAL="$HOME/.local/bin/pi-nvim-editor" EDITOR="$HOME/.local/bin/pi-nvim-editor" command pi'
