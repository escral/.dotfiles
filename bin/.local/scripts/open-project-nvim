#!/usr/bin/env zsh
# @action group:scripts exec:i3-sensible-terminal -e zsh $HOME/.local/scripts/open-project-nvim title:Open Neovim in directory (or pwd)

dir=$1

# If no argument is given, open nvim in the current directory
if [[ -z $dir ]]; then
    dir=$(pwd)
fi

cd $dir

kitty @ set-spacing padding=0
kitty @ set-window-title nvim

nvim
