#!/usr/bin/env bash
# @action group:scripts title:Open project in IDE (fzf marks picker)
set -euo pipefail

MARKS_FILE="${FZF_MARKS_FILE:-$HOME/.fzf-marks}"

if [[ ! -f "$MARKS_FILE" ]]; then
    notify-send "open-project-ide" "Marks file not found: $MARKS_FILE"
    exit 1
fi

escape_markup() {
    local s="$1"
    s="${s//&/&amp;}"
    s="${s//</&lt;}"
    s="${s//>/&gt;}"
    printf '%s' "$s"
}

format_mark() {
    local line="$1"
    local label="${line%% : *}"
    local path="${line##* : }"

    local label_markup
    label_markup="<b>$(escape_markup "$label")</b>"

    local colored_path
    if [[ "$path" == /var/www* ]]; then
        local rest
        rest=$(escape_markup "${path#/var/www}")
        colored_path='<span foreground="#949cbb">www</span><span foreground="#8caaee">'"${rest}"'</span>'
    elif [[ "$path" == "$HOME"* ]]; then
        local rest
        rest=$(escape_markup "${path#$HOME}")
        colored_path='<span foreground="#949cbb">~</span><span foreground="#8caaee">'"${rest}"'</span>'
    else
        colored_path='<span foreground="#8caaee">'"$(escape_markup "$path")"'</span>'
    fi

    printf '%s  %s' "$label_markup" "$colored_path"
}

orig_marks=()
display_lines=()

while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line// }" ]] && continue
    orig_marks+=("$line")
    display_lines+=("$(format_mark "$line")")
done < "$MARKS_FILE"

[[ ${#display_lines[@]} -eq 0 ]] && exit 0

chosen_idx=$(printf '%s\n' "${display_lines[@]}" | rofi -dmenu -p " Project" -i \
    -format i -markup-rows -matching fuzzy -sort \
    -theme-str 'window {width:50%;}') || exit 0

[[ -z "$chosen_idx" ]] && exit 0

dir="${orig_marks[$chosen_idx]##* : }"

if [[ ! -d "$dir" ]]; then
    notify-send "open-project-ide" "Directory not found: $dir"
    exit 1
fi

exec "$HOME/.local/scripts/ide" "$dir"
