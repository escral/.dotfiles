# Per-path IDE overrides (checked before composer.json / package.json).
# Format: path_or_prefix ide
#   path: absolute, or ~ for home. If the target directory equals this path or
#   lies under it, that IDE is used (longest matching prefix wins).
# ide: webstorm | phpstorm | nvim
#
# Add a new exception: append a line "<path> <ide>" (see ~/.local/scripts/ide header).

~/.dotfiles webstorm
~/environment webstorm
/var/www/tbc-argo-v2 phpstorm
/var/www/tbc-back-office-frontend webstorm
/var/www/jetbrains-plugins webstorm
